# Register display tester commands
# This works around the mc_ prefix registration issue in Renode 1.16+

include $ORIGIN/segment_display_tester.py

macro RegisterDisplayTester
    python "segment_display_tester.mc_RegisterSegmentDisplayTester('$1', '$2')"
end

macro GetDisplayRowData
    python "segment_display_tester.mc_GetDisplayRowData('$1', $2)"
end

macro GetAllDisplayData
    python "segment_display_tester.mc_GetAllDisplayData('$1')"
end

macro IsDisplayEnabled
    python "segment_display_tester.mc_IsDisplayEnabled('$1')"
end

macro GetDimmingLevel
    python "segment_display_tester.mc_GetDimmingLevel('$1')"
end

macro WaitForDisplayData
    python "segment_display_tester.mc_WaitForDisplayData('$1', $2, $3)"
end
