# I2C Capture Tester commands
# Provides macros to capture and verify I2C data for testing

include $ORIGIN/i2c_capture_tester.py

macro RegisterI2CCaptureTester
    python "mc_RegisterI2CCaptureTester('$1', '$2')"
end

macro WaitForI2CData
    python "mc_WaitForI2CData('$1', $2, $3)"
end

macro GetI2CCapturedData
    python "mc_GetI2CCapturedData('$1')"
end

macro ClearI2CCapturedData
    python "mc_ClearI2CCapturedData('$1')"
end

macro AssertI2CData
    python "mc_AssertI2CData('$1', $2, $3)"
end

macro AssertAnyCapturedWriteLength
    python "mc_AssertAnyCapturedWriteLength('$1', $2)"
end
